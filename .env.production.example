NODE_ENV=production
PORT=8080

# Domain
FRONTEND_ORIGIN=https://YOUR-DOMAIN.RU
PUBLIC_API_URL=https://YOUR-DOMAIN.RU

# Timeweb Cloud PostgreSQL
PGHOST=YOUR_POSTGRES_HOST
PGPORT=5432
PGUSER=YOUR_POSTGRES_USER
PGPASSWORD=YOUR_POSTGRES_PASSWORD
PGDATABASE=YOUR_POSTGRES_DB
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=false

# Security
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
DIGIT_SYNC_API_KEY=REPLACE_WITH_THE_SAME_KEY_USED_IN_DIGIT

# First website admin (created once if admins table is empty)
ADMIN_EMAIL=admin@YOUR-DOMAIN.RU
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Timeweb S3
S3_ENDPOINT=https://YOUR-S3-ENDPOINT
S3_REGION=ru-1
S3_BUCKET=YOUR_BUCKET
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_PUBLIC_URL=https://YOUR-PUBLIC-BUCKET-URL
S3_FORCE_PATH_STYLE=false